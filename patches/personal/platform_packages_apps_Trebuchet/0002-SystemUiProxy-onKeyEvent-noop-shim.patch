From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ponces <ponces26@gmail.com>
Date: Fri, 23 May 2026 00:00:00 +0000
Subject: [PATCH] SystemUiProxy: make onKeyEvent a no-op shim

The ISystemUiProxy AIDL in the GSI framework does not declare
onKeyEvent(int), so the @Override and the IPC call fail to compile.
Keep the method as a local no-op shim for Launcher-side callers.
---
diff --git a/quickstep/src/com/android/quickstep/SystemUiProxy.java b/quickstep/src/com/android/quickstep/SystemUiProxy.java
index ebbca36ee5..468404f7c9 100644
--- a/quickstep/src/com/android/quickstep/SystemUiProxy.java
+++ b/quickstep/src/com/android/quickstep/SystemUiProxy.java
@@ -210,15 +210,10 @@ public class SystemUiProxy implements ISystemUiProxy, NavHandle {
         }
     }
 
-    @Override
+    // Current ISystemUiProxy in this tree does not expose onKeyEvent(int).
+    // Keep this method only as a local compatibility shim for Launcher-side callers.
     public void onKeyEvent(int keycode) {
-        if (mSystemUiProxy != null) {
-            try {
-                mSystemUiProxy.onKeyEvent(keycode);
-            } catch (RemoteException e) {
-                Log.w(TAG, "Failed call onKeyEvent", e);
-            }
-        }
+        // no-op
     }
 
     @Override
-- 
2.34.1
